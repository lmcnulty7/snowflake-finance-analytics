# Copy this file to secrets.toml and fill in your Snowflake credentials.
# secrets.toml is gitignored and will not be committed.

[connections.snowflake]
account = "YOUR_ACCOUNT"
user = "YOUR_USER"
password = "YOUR_PASSWORD"
role = "YOUR_ROLE"
warehouse = "YOUR_WAREHOUSE"
database = "finance_analytics"
schema = "core"
